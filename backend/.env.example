# Copy this file to .env and adjust if needed.

# API server (only reachable from this computer by default)
HOST=127.0.0.1
PORT=4100

# Where collected data is saved (relative to the backend folder)
DATA_DIR=data

# Post-quantum (ML-DSA-65) signing key folder. Created automatically. Never commit it, back it up safely.
KEYS_DIR=keys

# Domain used in device identities (DIDs). Change to your real domain before production.
DID_DOMAIN=trustedocean.local

# Polite identification for public data providers. Put a real contact email here.
HTTP_USER_AGENT=TrustedOcean/0.1 (contact: your-email@example.com)

# Browser address of the future dashboard (for CORS)
CORS_ORIGIN=http://localhost:5173

# Database (TimescaleDB in Docker, see docker-compose.yml). Only reachable from this computer.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=trusted_ocean
DB_USER=ocean
DB_PASSWORD=change-me-to-a-long-random-password

# NOAA NDBC buoys (public domain, no key needed)
NDBC_ENABLED=true
NDBC_INTERVAL_MINUTES=10
NDBC_URL=https://www.ndbc.noaa.gov/data/latest_obs/latest_obs.txt

# Argo profiling floats via Ifremer ERDDAP (free, citation required, no key needed)
ARGO_ENABLED=true
ARGO_INTERVAL_MINUTES=360
ARGO_ERDDAP_SERVER=https://erddap.ifremer.fr/erddap
ARGO_LOOKBACK_DAYS=2
ARGO_MAX_PRESSURE_DBAR=10

# Copernicus Marine In Situ observations (free account; run `copernicusmarine login` once)
COPERNICUS_ENABLED=true
COPERNICUS_INTERVAL_MINUTES=180
COPERNICUS_LOOKBACK_HOURS=24
# MO mooring, DB drifting buoy, TG tide gauge, GL glider, SD sail drone, FB ferrybox
COPERNICUS_PLATFORM_TYPES=MO,DB,TG,GL,SD,FB
COPERNICUS_MAX_FILES=300
# Optional area: lon_min,lat_min,lon_max,lat_max (empty = whole world). Example Indian Ocean: 30,-40,120,30
COPERNICUS_BBOX=

# OBIS biodiversity records (no key). Default: only eDNA records from the last 5 years.
OBIS_ENABLED=true
OBIS_INTERVAL_MINUTES=360
OBIS_EDNA_ONLY=true
OBIS_LOOKBACK_YEARS=5
OBIS_MAX_RECORDS_PER_RUN=30000
# Optional area as WKT, example Indian Ocean: POLYGON((30 -40, 120 -40, 120 30, 30 30, 30 -40))
OBIS_GEOMETRY=POLYGON((30 -40, 120 -40, 120 30, 30 30, 30 -40))
